generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATION_MANAGER
  CSM
  ACCOUNTS
  PRODUCTION
  PRODUCTION_MANAGER
  /// Reviews, pays and closes payment requests.
  COST_CONTROL_MANAGER
  /// Field staff. They log in to see their own jobs and raise payment requests.
  /// "Sub-Paster" / "Ast. Paster" in the old sheets is a HELPER.
  PASTER
  HELPER
  DRIVER
}

/// What a code in the old work-allocation sheets stands for. Codes arrive from the
/// spreadsheets before anyone has said what they are, hence UNKNOWN.
enum CsmCodeKind {
  CSM
  TEAM
  BRANCH
  UNKNOWN
}

/// Field-job lifecycle. COMPLETED and CANCELLED are final.
enum WorkJobStatus {
  ASSIGNED
  STARTED
  COMPLETED
  HOLD
  CANCELLED
}

/// Overtime entries wait for an Admin's decision.
enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Local = Hyderabad city. Non-local work shows as "-N" on the allocation grid.
enum AreaLocality {
  LOCAL
  NON_LOCAL
}

enum OrderStatus {
  Active
  Pending
  Installed
  BillingCompleted
  PaymentReceived
  Completed
}

enum RemarkType {
  Reprint
  Sample
  UnderWarranty
  Revised
  ExtraAmount
  LessAmount
  FreeOfCost
  Other
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  username      String           @unique
  password      String
  role          Role
  email         String?
  phone         String?
  photo_url     String?
  is_super_admin Boolean         @default(false)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  last_login_at DateTime?
  is_active     Boolean          @default(true)
  /// Company employee code (105–402 in the staff master). Optional: not everyone has one.
  emp_code      String?          @unique
  orders        Order[]
  changeLogs    OrderChangeLog[]
  notifications Notification[]
  remarkedItems OrderItem[]      @relation("ItemRemarkSetter")
  confirmedItems OrderItem[]     @relation("ItemRemarkConfirmer")
  flaggedItems  OrderItem[]      @relation("ItemFlagger")
  assignments   OrderItemAssignment[] @relation("AssignmentAssignee")
  assignmentsMade OrderItemAssignment[] @relation("AssignmentAssigner")
  followUps       PaymentFollowUp[] @relation("FollowUpAuthor")
  installedStores OrderStore[]    @relation("StoreInstaller")
  invoicePayments Invoice[]       @relation("InvoicePaymentReceiver")
  csmCodes        CsmCode[]
  usualVehicles   Vehicle[]       @relation("VehicleUsualDriver")
  workJobsCreated WorkJob[]       @relation("WorkJobCreator")
  workJobsStarted WorkJob[]       @relation("WorkJobStarter")
  workJobsCompleted WorkJob[]     @relation("WorkJobCompleter")
  workJobSlots    WorkJobMember[]
  leaveRecords    LeaveRecord[]   @relation("LeavePerson")
  leaveEntered    LeaveRecord[]   @relation("LeaveCreator")
  leaveCancelled  LeaveRecord[]   @relation("LeaveCanceller")
  overtime        OvertimeEntry[] @relation("OvertimePerson")
  overtimeEntered OvertimeEntry[] @relation("OvertimeCreator")
  overtimeDecided OvertimeEntry[] @relation("OvertimeDecider")
  paymentRequests PaymentRequest[] @relation("PaymentRequester")
  paymentsPaid    PaymentRequest[] @relation("PaymentPayer")
  paymentsClosed  PaymentRequest[] @relation("PaymentCloser")
  paymentEvents   PaymentRequestEvent[]
}

model OrderSequence {
  id          Int     @id @default(1)
  year_code   String
  last_number Int     @default(0)
  is_locked   Boolean @default(false)
}

/// The identity and numbering record for a job. Stores, line items and invoices hang off
/// it; nothing about a particular store or a particular invoice lives here any more.
model Order {
  id                     Int                   @id @default(autoincrement())
  order_no               String                @unique
  client_name            String
  date                   DateTime              @default(now())
  /// Job-level PO covering the whole order. Per-store POs live on OrderStore.
  po_number              String?
  /// Derived from the stores and invoices — see utils/order-derive.ts. Never assign it
  /// directly, except `Completed`, which an admin sets by closing the order.
  status                 OrderStatus           @default(Active)
  created_by             Int?
  creator                User?                 @relation(fields: [created_by], references: [id], onDelete: SetNull)
  creator_name           String
  remarks                RemarkType?
  remarks_other_text     String?
  items                  OrderItem[]
  stores                 OrderStore[]
  invoices               Invoice[]
  changeLogs             OrderChangeLog[]
  notifications          Notification[]        @relation("OrderNotifications")
  followUps              PaymentFollowUp[]
  workJobs               WorkJob[]
  paymentRequests        PaymentRequest[]
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  @@index([client_name])
  @@index([status])
  @@index([created_by])
}

model OrderItem {
  id            Int         @id @default(autoincrement())
  order_id      Int
  order         Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  // order_id is kept alongside order_store_id on purpose: every existing order.items
  // read keeps working, and the composite key below makes the two impossible to
  // disagree — Postgres rejects an item whose order differs from its store's order.
  order_store_id Int
  orderStore    OrderStore  @relation(fields: [order_id, order_store_id], references: [order_id, id], onDelete: Cascade)
  // s_no numbers the item within its store, not within the order.
  s_no          Int
  media         String
  width_inches  Decimal     @db.Decimal(10, 2)
  height_inches Decimal     @db.Decimal(10, 2)
  qty           Decimal     @db.Decimal(10, 2)
  total_sft     Decimal     @db.Decimal(10, 2)
  rate          Decimal     @db.Decimal(10, 2)
  amount        Decimal     @db.Decimal(10, 2)
  remarks       RemarkType?
  remarks_other_text String?
  remarks_set_at DateTime?
  remarks_set_by Int?
  remarksSetter  User?     @relation("ItemRemarkSetter", fields: [remarks_set_by], references: [id], onDelete: SetNull)
  remarks_confirmed Boolean @default(false)
  remarks_confirmed_at DateTime?
  remarks_confirmed_by Int?
  remarksConfirmer User?   @relation("ItemRemarkConfirmer", fields: [remarks_confirmed_by], references: [id], onDelete: SetNull)
  is_flagged     Boolean   @default(false)
  flag_reason    String?
  flagged_at     DateTime?
  flagged_by     Int?
  flagger        User?     @relation("ItemFlagger", fields: [flagged_by], references: [id], onDelete: SetNull)
  // A line item may be split across several production teams. It is only
  // production-complete once every assignment on it is complete.
  assignments             OrderItemAssignment[]
  production_completed    Boolean   @default(false)
  production_completed_at DateTime?

  @@index([order_store_id])
}

/// One physical store within an order. Twenty stores handed over together share a single
/// order_no and appear as twenty OrderStore rows, each with its own line items, its own
/// installation date and its own PO.
model OrderStore {
  id           Int         @id @default(autoincrement())
  order_id     Int
  order        Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  /// 1-based within the order. Referenced in the UI as "ORD260123 / S03 — Banjara Hills".
  s_no         Int
  store_name   String
  location     String
  /// Per-store PO. The job-level PO covering the whole order lives on Order.po_number.
  po_number    String?
  installed_at DateTime?
  installed_by Int?
  installer    User?       @relation("StoreInstaller", fields: [installed_by], references: [id], onDelete: SetNull)
  /// The invoice this store was billed on. Null until accounts raises one covering it.
  invoice_id   Int?
  invoice      Invoice?    @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  items        OrderItem[]
  workJobs     WorkJobStore[]
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  /// Redundant against the primary key, but required as the target of OrderItem's
  /// composite foreign key.
  @@unique([order_id, id])
  @@unique([order_id, s_no])
  @@index([order_id])
  @@index([invoice_id])
  @@index([store_name])
}

/// One invoice raised against a specific set of stores in an order. Its expected value is
/// the billable total of the stores pointing at it, not of the whole order.
model Invoice {
  id                   Int          @id @default(autoincrement())
  order_id             Int
  order                Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  invoice_no           String
  bill_amount          Decimal      @db.Decimal(10, 2)
  billing_date         DateTime?
  billing_completed_at DateTime?
  amount_received      Decimal?     @db.Decimal(10, 2)
  payment_received_at  DateTime?
  payment_received_by  Int?
  paymentReceiver      User?        @relation("InvoicePaymentReceiver", fields: [payment_received_by], references: [id], onDelete: SetNull)
  stores               OrderStore[]
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  /// Scoped to the order, not global: historical invoice numbers are not globally unique.
  @@unique([order_id, invoice_no])
  @@index([order_id])
}

model OrderItemAssignment {
  id            Int       @id @default(autoincrement())
  order_item_id Int
  orderItem     OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  user_id       Int
  user          User      @relation("AssignmentAssignee", fields: [user_id], references: [id], onDelete: Cascade)
  assigned_at   DateTime  @default(now())
  assigned_by   Int?
  assigner      User?     @relation("AssignmentAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)
  completed     Boolean   @default(false)
  completed_at  DateTime?

  @@unique([order_item_id, user_id])
  @@index([user_id])
}

model OrderChangeLog {
  id            Int      @id @default(autoincrement())
  order_id      Int
  order         Order    @relation(fields: [order_id], references: [id])
  order_item_id Int?
  changed_by    Int?
  changer       User?    @relation(fields: [changed_by], references: [id], onDelete: SetNull)
  field_changed String
  old_value     String
  new_value     String
  changed_at    DateTime @default(now())
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  table_name String
  record_id  Int
  action     String
  changed_by Int?
  user_name  String?
  old_data   Json?
  new_data   Json?
  changed_at DateTime @default(now())
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  body       String
  kind       String   @default("info")
  read       Boolean  @default(false)
  order_id   Int?
  order      Order?   @relation("OrderNotifications", fields: [order_id], references: [id], onDelete: SetNull)
  created_at DateTime @default(now())

  @@index([user_id])
}

model PaymentFollowUp {
  id         Int      @id @default(autoincrement())
  order_id   Int
  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  note       String
  created_by Int?
  author     User?    @relation("FollowUpAuthor", fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime @default(now())

  @@index([order_id])
}

model EmailRecipient {
  id         Int      @id @default(autoincrement())
  email      String
  used_by    Int
  used_at    DateTime @default(now())

  @@unique([email, used_by])
  @@index([used_by])
}

model Client {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
}

model Media {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
}

/// A code used to identify who a field job is for (600, 088, NSG, SBDV …). A code may
/// belong to a CSM who is an app user, or to a team or branch with no login.
model CsmCode {
  id         Int         @id @default(autoincrement())
  code       String      @unique
  kind       CsmCodeKind @default(UNKNOWN)
  /// What the code means when it is not a person, e.g. "Vizag branch".
  label      String?
  user_id    Int?
  user       User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  jobs       WorkJob[]   @relation("WorkJobCsm")
  jobsAsCsm2 WorkJob[]   @relation("WorkJobCsm2")
  overtime   OvertimeEntry[]
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@index([user_id])
}

/// Where field work happens. Locality drives the Local / Non-local split on the grid.
model Area {
  id                 Int          @id @default(autoincrement())
  name               String       @unique
  locality           AreaLocality
  district           String?
  /// Imported areas whose locality the business has not confirmed yet.
  needs_confirmation Boolean      @default(false)
  is_active          Boolean      @default(true)
  workJobs           WorkJob[]
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  reg_no          String   @unique
  type            String
  usual_driver_id Int?
  usualDriver     User?    @relation("VehicleUsualDriver", fields: [usual_driver_id], references: [id], onDelete: SetNull)
  notes           String?
  is_active       Boolean  @default(true)
  workJobs        WorkJob[]
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([usual_driver_id])
}

/// One field job: a team sent to work on an order over one or more days. Replaces a row
/// of the old "Task Log" sheet; the weekly grid and the daily board are derived from these.
model WorkJob {
  id                   Int             @id @default(autoincrement())
  /// W00001, W00002 … from the work_job_no_seq sequence (see the migration).
  job_no               String          @unique @default(dbgenerated("('W'::text || lpad((nextval('work_job_no_seq'::regclass))::text, 5, '0'::text))"))
  order_id             Int
  order                Order           @relation(fields: [order_id], references: [id], onDelete: Restrict)
  start_date           DateTime        @db.Date
  /// Same as start_date for a one-day job.
  end_date             DateTime        @db.Date
  csm_code_id          Int?
  csmCode              CsmCode?        @relation("WorkJobCsm", fields: [csm_code_id], references: [id], onDelete: SetNull)
  /// Work shared with a second CSM on the same day.
  csm2_code_id         Int?
  csm2Code             CsmCode?        @relation("WorkJobCsm2", fields: [csm2_code_id], references: [id], onDelete: SetNull)
  work_details         String
  area_id              Int
  area                 Area            @relation(fields: [area_id], references: [id], onDelete: Restrict)
  /// Copied from the area when the job is saved, so re-classifying an area later does
  /// not rewrite history.
  locality             AreaLocality
  vehicle_id           Int?
  vehicle              Vehicle?        @relation(fields: [vehicle_id], references: [id], onDelete: SetNull)
  route                String?
  extra_tag            String?
  instructions         String?
  /// "Allow 2nd job": lets this job overlap other work for the same people.
  allow_double_booking Boolean         @default(false)
  status               WorkJobStatus   @default(ASSIGNED)
  started_at           DateTime?
  /// Who marked it started / completed: a team member from My Work, or a manager.
  started_by           Int?
  starter              User?           @relation("WorkJobStarter", fields: [started_by], references: [id], onDelete: SetNull)
  completed_at         DateTime?
  completed_by         Int?
  completer            User?           @relation("WorkJobCompleter", fields: [completed_by], references: [id], onDelete: SetNull)
  /// Optional note left when the job was marked completed.
  completion_note      String?
  cancelled_at         DateTime?
  cancel_reason        String?
  created_by           Int?
  creator              User?           @relation("WorkJobCreator", fields: [created_by], references: [id], onDelete: SetNull)
  members              WorkJobMember[]
  stores               WorkJobStore[]
  overtime             OvertimeEntry[]
  paymentRequests      PaymentRequest[]
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  @@index([order_id])
  @@index([start_date, end_date])
  @@index([status])
}

/// A person on a job. The job's dates are copied here so the database itself can refuse
/// to book one person on two overlapping jobs (exclusion constraint in the migration).
model WorkJobMember {
  id              Int      @id @default(autoincrement())
  job_id          Int
  job             WorkJob  @relation(fields: [job_id], references: [id], onDelete: Cascade)
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  /// PASTER, HELPER or DRIVER: the person's role when they were put on the job.
  slot_role       Role
  start_date      DateTime @db.Date
  end_date        DateTime @db.Date
  /// False when the job is cancelled or allows double booking. Only rows with this set
  /// take part in the no-overlap constraint.
  blocks_calendar Boolean  @default(true)

  @@unique([job_id, user_id])
  @@index([user_id, start_date])
}

/// The stores of the order a job covers. Optional: a job may cover the whole order.
model WorkJobStore {
  job_id         Int
  job            WorkJob    @relation(fields: [job_id], references: [id], onDelete: Cascade)
  order_store_id Int
  orderStore     OrderStore @relation(fields: [order_store_id], references: [id], onDelete: Cascade)

  @@id([job_id, order_store_id])
  @@index([order_store_id])
}

/// Leave register: a field-staff member is unavailable for whole days. Leave blocks
/// allocation outright ("Allow 2nd job" does not override it). One person's live leave
/// records never overlap (exclusion constraint in the migration).
model LeaveRecord {
  id            Int       @id @default(autoincrement())
  user_id       Int
  user          User      @relation("LeavePerson", fields: [user_id], references: [id], onDelete: Restrict)
  from_date     DateTime  @db.Date
  /// Same as from_date for one day.
  to_date       DateTime  @db.Date
  reason        String?
  created_by    Int?
  creator       User?     @relation("LeaveCreator", fields: [created_by], references: [id], onDelete: SetNull)
  /// Cancelled leave is kept for history and no longer blocks anything.
  cancelled_at  DateTime?
  cancelled_by  Int?
  canceller     User?     @relation("LeaveCanceller", fields: [cancelled_by], references: [id], onDelete: SetNull)
  cancel_reason String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([user_id, from_date])
  @@index([from_date, to_date])
}

/// Overtime register: one row per person per stretch of extra work. Hours come from the
/// start and close times; a close earlier than the start means the work ran past midnight.
model OvertimeEntry {
  id            Int            @id @default(autoincrement())
  user_id       Int
  user          User           @relation("OvertimePerson", fields: [user_id], references: [id], onDelete: Restrict)
  /// The day the overtime started (India time).
  work_date     DateTime       @db.Date
  /// "HH:MM", 24-hour, India time.
  start_time    String
  end_time      String
  minutes       Int
  /// Minutes since 1970-01-01 00:00 India time at the start, so the database can stop
  /// one person's entries overlapping, including across midnight.
  start_minute  Int
  work_job_id   Int?
  workJob       WorkJob?       @relation(fields: [work_job_id], references: [id], onDelete: SetNull)
  csm_code_id   Int?
  csmCode       CsmCode?       @relation(fields: [csm_code_id], references: [id], onDelete: SetNull)
  remarks       String?
  status        OvertimeStatus @default(PENDING)
  decided_by    Int?
  decider       User?          @relation("OvertimeDecider", fields: [decided_by], references: [id], onDelete: SetNull)
  decided_at    DateTime?
  reject_reason String?
  created_by    Int?
  creator       User?          @relation("OvertimeCreator", fields: [created_by], references: [id], onDelete: SetNull)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  @@index([user_id, work_date])
  @@index([work_date])
  @@index([status])
}

/// Where a payment request sits. Rules live in utils/payment-workflow.ts.
enum PaymentRequestStatus {
  ADMIN_REVIEW
  CCM_REVIEW
  /// Sent back to the requester; resubmitting returns it to `returned_from`.
  INFO_REQUESTED
  PAYMENT_PENDING
  PAID
  CLOSED
  REJECTED
  CANCELLED
}

/// Fixed when the request is submitted, from "Bill details required?".
enum PaymentRoute {
  /// No bill details: the Admin approves first, then the Cost Control Manager.
  ADMIN_THEN_CCM
  /// Bill details given: straight to the Cost Control Manager.
  CCM_ONLY
}

enum PaymentCategory {
  TRAVEL
  MATERIAL
  LABOUR
  FOOD
  ADVANCE
  OTHER
}

enum PaymentAction {
  SUBMIT
  APPROVE
  REJECT
  RETURN
  RESUBMIT
  CANCEL
  MARK_PAID
  CLOSE
}

/// Money the company pays out to the requester by UPI. Never order revenue.
model PaymentRequest {
  id                    Int                   @id @default(autoincrement())
  /// PR-YYMM-0001, minted from payment_request_no_seq (see the migration).
  request_no            String                @unique
  order_id              Int
  order                 Order                 @relation(fields: [order_id], references: [id], onDelete: Restrict)
  work_job_id           Int?
  workJob               WorkJob?              @relation(fields: [work_job_id], references: [id], onDelete: SetNull)
  /// The requester is also the payee.
  requested_by          Int
  requester             User                  @relation("PaymentRequester", fields: [requested_by], references: [id], onDelete: Restrict)
  amount                Decimal               @db.Decimal(10, 2)
  upi_id                String
  category              PaymentCategory?
  purpose               String
  remarks               String?
  bill_details_required Boolean
  route                 PaymentRoute
  status                PaymentRequestStatus
  returned_from         PaymentRequestStatus?
  /// When the request entered its current status; the Phase H overdue timers read it.
  status_changed_at     DateTime              @default(now())
  paid_amount           Decimal?              @db.Decimal(10, 2)
  paid_at               DateTime?
  /// UTR or other bank reference, required to mark a request paid.
  payment_reference     String?
  paid_by               Int?
  payer                 User?                 @relation("PaymentPayer", fields: [paid_by], references: [id], onDelete: SetNull)
  closed_at             DateTime?
  closed_by             Int?
  closer                User?                 @relation("PaymentCloser", fields: [closed_by], references: [id], onDelete: SetNull)
  /// Sent by the client with each new request so a double submit creates one row.
  idempotency_key       String                @unique
  events                PaymentRequestEvent[]
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  @@index([order_id])
  @@index([requested_by])
  @@index([status])
}

/// Append-only history of a payment request. The migration blocks updates.
model PaymentRequestEvent {
  id          Int                   @id @default(autoincrement())
  request_id  Int
  request     PaymentRequest        @relation(fields: [request_id], references: [id], onDelete: Cascade)
  action      PaymentAction
  from_status PaymentRequestStatus?
  to_status   PaymentRequestStatus
  actor_id    Int?
  actor       User?                 @relation(fields: [actor_id], references: [id], onDelete: SetNull)
  actor_role  Role
  note        String?
  created_at  DateTime              @default(now())

  @@index([request_id])
}
