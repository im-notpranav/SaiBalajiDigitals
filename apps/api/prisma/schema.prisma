generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  ACCOUNTS
  PRODUCTION
  OPERATOR
}

enum OrderStatus {
  Active
  Pending
  Completed
}

enum RemarkType {
  Reprint
  Sample
  UnderWarranty
  Revised
  ExtraAmount
  LessAmount
  FreeOfCost
  Other
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  username      String           @unique
  password      String
  role          Role
  email         String?
  phone         String?
  photo_url     String?
  is_super_admin Boolean         @default(false)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  last_login_at DateTime?
  is_active     Boolean          @default(true)
  orders        Order[]
  changeLogs    OrderChangeLog[]
  notifications Notification[]
  remarkedItems OrderItem[]      @relation("ItemRemarkSetter")
  confirmedItems OrderItem[]     @relation("ItemRemarkConfirmer")
  flaggedItems  OrderItem[]      @relation("ItemFlagger")
  assignedItems OrderItem[]      @relation("ItemAssignee")
  itemsAssignedByMe OrderItem[]  @relation("ItemAssigner")
  producedItems OrderItem[]      @relation("ItemProductionCompleter")
}

model OrderSequence {
  id          Int     @id @default(1)
  year_code   String
  last_number Int     @default(0)
  is_locked   Boolean @default(false)
}

model Order {
  id                     Int                   @id @default(autoincrement())
  order_no               String                @unique
  client_name            String
  store_name             String
  location               String
  date                   DateTime              @default(now())
  po_number              String?
  status                 OrderStatus           @default(Active)
  invoice_no             String?
  bill_amount            Decimal?              @db.Decimal(10, 2)
  created_by             Int?
  creator                User?                 @relation(fields: [created_by], references: [id], onDelete: SetNull)
  creator_name           String
  remarks                RemarkType?
  remarks_other_text     String?
  items                  OrderItem[]
  changeLogs             OrderChangeLog[]
  notifications          Notification[]        @relation("OrderNotifications")
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  @@index([client_name])
  @@index([store_name])
  @@index([status])
  @@index([created_by])
}

model OrderItem {
  id            Int         @id @default(autoincrement())
  order_id      Int
  order         Order       @relation(fields: [order_id], references: [id], onDelete: Cascade)
  s_no          Int
  media         String
  width_inches  Decimal     @db.Decimal(10, 2)
  height_inches Decimal     @db.Decimal(10, 2)
  qty           Decimal     @db.Decimal(10, 2)
  total_sft     Decimal     @db.Decimal(10, 2)
  rate          Decimal     @db.Decimal(10, 2)
  amount        Decimal     @db.Decimal(10, 2)
  remarks       RemarkType?
  remarks_other_text String?
  remarks_set_at DateTime?
  remarks_set_by Int?
  remarksSetter  User?     @relation("ItemRemarkSetter", fields: [remarks_set_by], references: [id], onDelete: SetNull)
  remarks_confirmed Boolean @default(false)
  remarks_confirmed_at DateTime?
  remarks_confirmed_by Int?
  remarksConfirmer User?   @relation("ItemRemarkConfirmer", fields: [remarks_confirmed_by], references: [id], onDelete: SetNull)
  is_flagged     Boolean   @default(false)
  flag_reason    String?
  flagged_at     DateTime?
  flagged_by     Int?
  flagger        User?     @relation("ItemFlagger", fields: [flagged_by], references: [id], onDelete: SetNull)
  assigned_to    Int?
  assignee       User?     @relation("ItemAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  assigned_at    DateTime?
  assigned_by    Int?
  assigner       User?     @relation("ItemAssigner", fields: [assigned_by], references: [id], onDelete: SetNull)
  production_completed    Boolean   @default(false)
  production_completed_at DateTime?
  production_completed_by Int?
  productionCompleter     User?     @relation("ItemProductionCompleter", fields: [production_completed_by], references: [id], onDelete: SetNull)

  @@index([assigned_to])
}

model OrderChangeLog {
  id            Int      @id @default(autoincrement())
  order_id      Int
  order         Order    @relation(fields: [order_id], references: [id])
  order_item_id Int?
  changed_by    Int?
  changer       User?    @relation(fields: [changed_by], references: [id], onDelete: SetNull)
  field_changed String
  old_value     String
  new_value     String
  changed_at    DateTime @default(now())
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  table_name String
  record_id  Int
  action     String
  changed_by Int?
  user_name  String?
  old_data   Json?
  new_data   Json?
  changed_at DateTime @default(now())
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  body       String
  kind       String   @default("info")
  read       Boolean  @default(false)
  order_id   Int?
  order      Order?   @relation("OrderNotifications", fields: [order_id], references: [id], onDelete: SetNull)
  created_at DateTime @default(now())

  @@index([user_id])
}

model Client {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
}

model Media {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
}
