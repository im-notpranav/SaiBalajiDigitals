# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sb_oms?schema=public"
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters"

# ─── Optional (defaults shown) ──────────────────────────────────────────────
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# ─── Email / SMTP ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications (server will log a
# warning and continue). Free-tier hosts (Render, Railway) typically block
# outbound ports 25/465/587 — use an HTTP-based provider like Resend or Brevo
# instead if email is needed in a hosted environment.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL="admin@saibalaji.com"
