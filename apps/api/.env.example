# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sb_oms?schema=public"
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters"

# ─── Optional (defaults shown) ──────────────────────────────────────────────
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# ─── File storage: Cloudflare R2 ────────────────────────────────────────────
# Token needs Object Read & Write on this bucket only. R2_PREFIX starts every key and
# defaults to "prod/" in production and "dev/" elsewhere, so one bucket can serve both.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ─── Email / SMTP ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications (server will log a
# warning and continue). Free-tier hosts (Render, Railway) typically block
# outbound ports 25/465/587 — use an HTTP-based provider like Resend or Brevo
# instead if email is needed in a hosted environment.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL="admin@saibalaji.com"

# ─── WhatsApp via AskEva ────────────────────────────────────────────────────
# "log" (default) writes every message to the delivery log and the server log
# without sending. Switch to "live" only once ASKEVA_TOKEN is set and the
# templates on the Admin → WhatsApp page are approved in AskEva.
WHATSAPP_MODE="log"
ASKEVA_SEND_URL="https://backend.askeva.io/v1/message/send-message"
ASKEVA_TOKEN=""
# Any long random string. Used as the webhook verify token and as ?key= on the
# delivery-report URL: https://<api-host>/api/webhooks/askeva?key=<secret>
ASKEVA_WEBHOOK_SECRET=""
# The web app's public address, for the "Open in app" button on every message
# (button URL in AskEva: <APP_URL>/go/{{1}}). Defaults to the first CLIENT_URL.
APP_URL=""
